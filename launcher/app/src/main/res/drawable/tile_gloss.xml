<?xml version="1.0" encoding="utf-8"?>
<!-- Soft glass highlight drawn over every tile (icon art and fallback faces alike), clipped to the
     card's rounded outline by the parent's clipToOutline. Brightest at the top edge, gone by mid-tile. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#24FFFFFF"
        android:centerColor="#0AFFFFFF"
        android:endColor="#00FFFFFF"
        android:centerY="0.42" />
</shape>
